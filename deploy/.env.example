# Copy to deploy/.env and fill every value. Generate secrets with: openssl rand -base64 32
POSTGRES_DB=grants
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=
APP_URL=https://grants.example.sa
SESSION_SECRET=
DATA_MASTER_KEY=
MANIH_WEBHOOK_SECRET=
OTP_SALT=
OPERATOR_TOKEN=
DEFAULT_PORTAL=almulhi
# Manih (the AI service). Empty = the deterministic mock.
MANIH_URL=
MANIH_API_KEY=
# A path on a different disk from the database.
BACKUP_DIR=/srv/wbl-backups
BACKUP_KEEP_DAYS=30
# External services; empty = local stand-ins.
AUTHENTICA_API_KEY=
ENTITIES_URL=
ENTITIES_API_KEY=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
