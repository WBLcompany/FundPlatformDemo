{
  "$description": "WBL design tokens for the grants platform. Source: WBL Visual Guidelines v01.02. Tokens with $extensions.wbl.derived=true are not in the guidelines and need brand approval.",
  "color": {
    "brand": {
      "deep-green":  { "$type": "color", "$value": "#063524", "$description": "Pantone 627C — structure, headings, primary button text" },
      "dark-green":  { "$type": "color", "$value": "#024C33", "$description": "Pantone 3308C — links, focus ring, chart bars" },
      "tech-green":  { "$type": "color", "$value": "#4EF98B", "$description": "Pantone 2412C — primary action fill. Never text on white" },
      "light-green": { "$type": "color", "$value": "#8AFFAB", "$description": "Pantone 352C — success fill, progress track" },
      "white":       { "$type": "color", "$value": "#FFFFFF" },
      "black":       { "$type": "color", "$value": "#000000" }
    },
    "secondary": {
      "blue":          { "$type": "color", "$value": "#3AEFE4" },
      "blue-light":    { "$type": "color", "$value": "#8BFCF1" },
      "khuzama":       { "$type": "color", "$value": "#A1A8FF", "$description": "Reserved for AI (Manih / Muhassin)" },
      "khuzama-light": { "$type": "color", "$value": "#B6BBFF" },
      "choral":        { "$type": "color", "$value": "#FC8C86" },
      "choral-light":  { "$type": "color", "$value": "#FFB4B0" },
      "neon":          { "$type": "color", "$value": "#E0FF80" },
      "neon-light":    { "$type": "color", "$value": "#F3FFD4" }
    },
    "neutral": {
      "50":  { "$type": "color", "$value": "#F4F7F5", "$extensions": { "wbl": { "derived": true } } },
      "100": { "$type": "color", "$value": "#E8EDEA", "$extensions": { "wbl": { "derived": true } } },
      "200": { "$type": "color", "$value": "#D3DCD7", "$extensions": { "wbl": { "derived": true } } },
      "500": { "$type": "color", "$value": "#5C6F67", "$extensions": { "wbl": { "derived": true } } }
    },
    "ink": {
      "khuzama": { "$type": "color", "$value": "#3A3F9E", "$extensions": { "wbl": { "derived": true } } },
      "choral":  { "$type": "color", "$value": "#9A2A23", "$extensions": { "wbl": { "derived": true } } },
      "neon":    { "$type": "color", "$value": "#4D5B00", "$extensions": { "wbl": { "derived": true } } }
    },
    "semantic": {
      "bg":             { "$type": "color", "$value": "{color.neutral.50}" },
      "surface":        { "$type": "color", "$value": "{color.brand.white}" },
      "surface-sunken": { "$type": "color", "$value": "{color.neutral.100}" },
      "border":         { "$type": "color", "$value": "{color.neutral.200}" },
      "text":           { "$type": "color", "$value": "{color.brand.deep-green}" },
      "text-muted":     { "$type": "color", "$value": "{color.neutral.500}" },
      "link":           { "$type": "color", "$value": "{color.brand.dark-green}" },
      "focus":          { "$type": "color", "$value": "{color.brand.dark-green}" },
      "action":         { "$type": "color", "$value": "{color.brand.tech-green}" },
      "action-text":    { "$type": "color", "$value": "{color.brand.deep-green}" },
      "chrome":         { "$type": "color", "$value": "{color.brand.deep-green}" },
      "success-bg":     { "$type": "color", "$value": "{color.brand.light-green}" },
      "info-bg":        { "$type": "color", "$value": "{color.secondary.blue-light}" },
      "warning-bg":     { "$type": "color", "$value": "{color.secondary.neon-light}" },
      "warning-text":   { "$type": "color", "$value": "{color.ink.neon}" },
      "danger-bg":      { "$type": "color", "$value": "{color.secondary.choral-light}" },
      "danger-text":    { "$type": "color", "$value": "{color.ink.choral}" },
      "ai-bg":          { "$type": "color", "$value": "{color.secondary.khuzama-light}" },
      "ai-text":        { "$type": "color", "$value": "{color.ink.khuzama}" },
      "ai-accent":      { "$type": "color", "$value": "{color.secondary.khuzama}" }
    },
    "chart": {
      "1": { "$type": "color", "$value": "{color.brand.dark-green}" },
      "2": { "$type": "color", "$value": "{color.secondary.blue}" },
      "3": { "$type": "color", "$value": "{color.secondary.khuzama}" },
      "4": { "$type": "color", "$value": "{color.secondary.choral}" },
      "track": { "$type": "color", "$value": "#D9FFE3", "$extensions": { "wbl": { "derived": true } } }
    }
  },
  "font": {
    "family": {
      "arabic": { "$type": "fontFamily", "$value": ["Ko Sans", "Tahoma", "sans-serif"] },
      "latin":  { "$type": "fontFamily", "$value": ["Google Sans Flex", "Ko Sans", "Tahoma", "sans-serif"] },
      "mono":   { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "32px" },
      "h1":      { "$type": "dimension", "$value": "24px" },
      "h2":      { "$type": "dimension", "$value": "20px" },
      "h3":      { "$type": "dimension", "$value": "16px" },
      "body":    { "$type": "dimension", "$value": "15px" },
      "body-sm": { "$type": "dimension", "$value": "13px" },
      "caption": { "$type": "dimension", "$value": "12px" }
    },
    "line-height": {
      "display": { "$type": "dimension", "$value": "44px" },
      "h1":      { "$type": "dimension", "$value": "36px" },
      "h2":      { "$type": "dimension", "$value": "30px" },
      "h3":      { "$type": "dimension", "$value": "26px" },
      "body":    { "$type": "dimension", "$value": "26px" },
      "body-sm": { "$type": "dimension", "$value": "22px" },
      "caption": { "$type": "dimension", "$value": "18px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium":  { "$type": "fontWeight", "$value": 500 },
      "bold":    { "$type": "fontWeight", "$value": 700 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" }
  },
  "shadow": {
    "float": { "$type": "shadow", "$value": { "color": "#0635241F", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" } }
  }
}
