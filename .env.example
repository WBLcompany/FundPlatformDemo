# Every variable below is required in production; a missing secret stops the process at startup.
# Local development falls back to fixed dev values (never use them outside localhost).
DATABASE_URL=postgres://authenticator:authenticator@localhost:54329/grants_dev
APP_URL=http://localhost:3000
SESSION_SECRET=
DATA_MASTER_KEY=
MANIH_WEBHOOK_SECRET=
OTP_SALT=
OPERATOR_TOKEN=
# Manih: leave MANIH_URL empty to use the deterministic mock.
MANIH_URL=
MANIH_API_KEY=
STORAGE_ROOT=./.storage
DEFAULT_PORTAL=almulhi
# External services; each adapter falls back to its local stand-in when its variables are empty.
AUTHENTICA_API_KEY=
ENTITIES_URL=
ENTITIES_API_KEY=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
CLAMD_HOST=
CLAMD_PORT=
GOTENBERG_URL=
